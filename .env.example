# Supabase → Project Settings → API (use these exact names in Vercel too)
SUPABASE_URL=https://YOUR-PROJECT-ref.supabase.co
SUPABASE_PUBLISHABLE_KEY=sb_publishable_xxx   # or the legacy anon key
SUPABASE_SECRET_KEY=sb_secret_xxx             # or the legacy service_role key — server only, never in frontend

# Optional
LOW_STOCK_THRESHOLD=10
# ALLOWED_ORIGIN=https://your-domain.com      # only if another site calls the API
